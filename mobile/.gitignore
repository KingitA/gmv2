# Dependencias y builds de las apps
node_modules/
apps/*/dist/
# Proyectos Android: se versiona el proyecto, no sus builds
apps/*/android/.gradle/
apps/*/android/build/
apps/*/android/app/build/
apps/*/android/local.properties
apps/*/android/capacitor-cordova-android-plugins/build/
apps/*/android/app/src/main/assets/public/
apps/*/android/app/src/main/assets/capacitor.config.json
apps/*/android/app/src/main/assets/capacitor.plugins.json
apps/*/android/app/src/main/res/xml/config.xml
# Nunca commitear keystores ni sus claves
*.jks
*.keystore
keystore.properties
.env
.env.local
